# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VAULTKEY_SECRET_KEY=replace_with_a_long_random_secret
VAULTKEY_DB=vaultkey.db
VAULTKEY_HOST=127.0.0.1
VAULTKEY_PORT=5000
VAULTKEY_DEBUG=0
COOKIE_SECURE=0
APP_ORIGIN=http://127.0.0.1:5000
SESSION_TTL_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=28800
RECOVERY_MINUTES=30
MAX_BODY_BYTES=65536
RATELIMIT_STORAGE_URI=memory://
SMTP_ENABLED=0
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=VaultKey
SMTP_FROM_EMAIL=
